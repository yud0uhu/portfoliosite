---
import { cn } from "../lib/utils";
---

<main class={cn(["terminal", "z-10"])} aria-label="yud0uhu.dev">
  <div class="titlebar" aria-hidden="true">~/yud0uhu.dev</div>
  <div class="screen">
    <p class="line">
      <span class="ps1">~ ❯</span><span class="cmd">whoami</span>
    </p>
    <p class="line out name">0yu</p>
    <p class="line out2 mt-6"><span class="ps1">~ ❯</span>ls</p>
    <p class="line out2">
      <a href="/about/" data-astro-reload>about/</a>
      <a href="/work/" data-astro-reload>work/</a>
    </p>
    <p class="line out2 mt-6">
      <span class="ps1">~ ❯</span><span class="cursor" aria-hidden="true"
      ></span>
    </p>
    <p class="footer"># ©0yu inc.</p>
  </div>
</main>

<style>
  .terminal {
    --ink: #2e2b33;
    --paper: #f6efdd;
    --red: #d9503f;
    --teal: #2f7f6e;
    --marker: #f0b45a;

    position: relative;
    width: min(640px, 92vw);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 10px;
    box-shadow: 8px 8px 0 var(--ink);
    font-family:
      ui-monospace, "SF Mono", "Cascadia Mono", "BIZ UDGothic", "Courier New",
      monospace;
  }

  .titlebar {
    text-align: center;
    padding: 10px 0 9px;
    font-size: 13px;
    color: #8f887a;
    border-bottom: 1.5px solid var(--ink);
    user-select: none;
  }

  .screen {
    padding: 34px 38px 26px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink);
  }

  .line {
    margin-bottom: 6px;
    white-space: nowrap;
  }

  .mt-6 {
    margin-top: 24px;
  }

  .ps1 {
    color: var(--red);
    margin-right: 10px;
  }

  .cmd {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    width: 0;
    animation: type 0.9s steps(6, end) 0.5s forwards;
  }

  .name {
    font-family: "Monomaniac One", ui-monospace, monospace;
    font-size: 30px;
    letter-spacing: 1px;
  }

  .out {
    opacity: 0;
    animation: appear 0.01s 1.6s forwards;
  }

  .out2 {
    opacity: 0;
    animation: appear 0.01s 2.1s forwards;
  }

  .screen a {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-right: 28px;
    padding: 1px 3px;
  }

  .screen a:hover,
  .screen a:focus-visible {
    background: var(--marker);
    text-decoration: none;
    outline: none;
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    background: var(--ink);
    vertical-align: text-bottom;
    animation: blink 1.1s steps(1) infinite;
  }

  .footer {
    margin-top: 32px;
    font-size: 13px;
    color: #8f887a;
  }

  @keyframes type {
    to {
      width: 6.2ch;
    }
  }

  @keyframes appear {
    to {
      opacity: 1;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 480px) {
    .screen {
      padding: 24px 20px 20px;
      font-size: 15px;
    }

    .terminal {
      box-shadow: 5px 5px 0 var(--ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cmd {
      animation: none;
      width: 6.2ch;
    }

    .out,
    .out2 {
      animation: none;
      opacity: 1;
    }

    .cursor {
      animation: none;
    }
  }
</style>
