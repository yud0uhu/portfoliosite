---
import MelonSodaAnimation from "./MelonSodaAnimation.svelte";
import TerminalCard from "./TerminalCard.astro";
import { cn } from "../lib/utils";
---

<script>
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" }),
  );
</script>
<div
  transition:animate="slide"
  class={cn([
    "h-screen",
    "w-full",
    "bg-radial-gradient",
    "absolute",
    "top-1/2",
    "left-1/2",
    "transform",
    "-translate-x-1/2",
    "-translate-y-1/2",
    "flex",
    "flex-col",
    "justify-center",
    "items-center",
    "overflow-hidden",
  ])}
>
  <div class={cn(["absolute", "inset-0", "z-0", "pointer-events-none"])}>
    <MelonSodaAnimation client:only="svelte" />
  </div>
  <TerminalCard />
</div>
